library(rvest)
library(dplyr)
url <- "https://www.nigeriawatch.org/index.php?urlaction=evtList"
# Read the HTML content of the page
page <- read_html(url)
# Extract the table
table <- page %>%
html_node("table") %>% # Locate the first table on the page
html_table(fill = TRUE)
# Clean the data (if necessary)
# Example cleaning: Renaming columns
colnames(table) <- c("IDENTIFIER", "TITLE", "START_DATE", "END_DATE", "NUMBER_OF_DEATHS", "LINK")
# Add the link for each IDENTIFIER
# Extract all the links from the first column
links <- page %>%
html_nodes("table a") %>%
html_attr("href")
# Append the links to the table
table <- table %>%
mutate(LINK = paste0("https://www.nigeriawatch.org/", links))
View(table)
