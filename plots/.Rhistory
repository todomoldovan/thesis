# Example DataFrame
df <- data.frame(
src = c("192.168.1.1:1234", "192.168.1.2:5678", "192.168.1.3:9101"),
dst = c("192.168.1.4:4321", "192.168.1.5:8765", "192.168.1.6:1019"),
duration = c(5, 10, 15),
packets = c(100, 200, 300),
proto = c("TCP", "UDP", "TCP"),
bytes = c(500, 1000, 1500)
)
library(igraph)
# Example DataFrame
df <- data.frame(
src = c("192.168.1.1:1234", "192.168.1.2:5678", "192.168.1.3:9101"),
dst = c("192.168.1.4:4321", "192.168.1.5:8765", "192.168.1.6:1019"),
duration = c(5, 10, 15),
packets = c(100, 200, 300),
proto = c("TCP", "UDP", "TCP"),
bytes = c(500, 1000, 1500)
)
# Create Graph
g <- graph_from_data_frame(df, directed = TRUE)
# Edge thickness based on duration
E(g)$width <- df$duration
# Edge line type based on packets
E(g)$lty <- ifelse(df$packets == 100, 1,
ifelse(df$packets == 200, 2, 3))  # 1 = solid, 2 = dashed, 3 = dotted
# Node shape based on protocol
V(g)$shape <- ifelse(V(g)$name %in% df$src[df$proto == "TCP"] |
V(g)$name %in% df$dst[df$proto == "TCP"], "circle", "square")
# Node size based on bytes
node_bytes <- setNames(df$bytes, df$src)
V(g)$size <- node_bytes[V(g)$name] / 100  # Scale down for better visualization
# Plot Graph
plot(g, vertex.label = NA, edge.arrow.size = 0.5)
