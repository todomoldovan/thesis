pod_counts_filtered <- pod_counts %>%
filter(n >= 5)
kable(pod_counts_filtered, format = "latex", booktabs = TRUE, caption = "Unique Podcast Titles with Counts") %>%
kable_styling(latex_options = c("hold_position", "striped"))
