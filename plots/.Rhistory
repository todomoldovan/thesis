df<- read_excel("Final_data.xlsx",
sheet = "Peru")
#creating time series
g_per <- ts(data=df$gdp_growth, start=1997, end=2016, frequency=1)
gini_per <- ts(data=df$gini_index, start=1997, end=2016, frequency=1)
w_per <- ts(data=df$wage_share, start=1997, end=2016, frequency=1)
cpi_per <- ts(data=df$csh_x, start=1997, end=2016, frequency=1)
gvn_per <- ts(data=df$gov_spend, start=1997, end=2016, frequency=1)
#creating difference data
cpi_per_1 = diff(cpi_per, differences = 1)
gvn_per_1 = diff(gvn_per, differences = 1)
g_per_1 = diff(g_per, differences = 1)
w_per_1 = diff(w_per, differences = 1)
gini_per_1 = data.frame(diff(gini_per, differences = 1))
### Perform Ljung-Box test on residuals
#VAR 1 estimation: growth, wage share
print("VAR 1 estimation: growth, wage share")
data_var1 <- cbind(g_per, w_per)
var1_per <- VAR(data_var1, p=1, type = "none")
residuals_var1_per <- residuals(var1_per)
print("Growth")
ljung_box_var1_per_g <- Box.test(residuals_var1_per[, 1], lag = 10, type = "Ljung-Box")
ljung_box_var1_per_g
print("Wage share")
ljung_box_var1_per_w <- Box.test(residuals_var1_per[, 2], lag = 10, type = "Ljung-Box")
ljung_box_var1_per_w
#VAR 1.2 estimation: same as above, but with everything in diff terms
print("VAR 1.2 estimation: same as above, but with everything in diff terms")
data_var12 <- cbind(g_per_1,w_per_1)
var12_per <- VAR(data_var12, p=1, type = "none")
residuals_var12_per <- residuals(var12_per)
print("Growth")
ljung_box_var12_per_g <- Box.test(residuals_var12_per[, 1], lag = 10, type = "Ljung-Box")
ljung_box_var12_per_g
print("Wage share")
ljung_box_var12_per_w <- Box.test(residuals_var12_per[, 2], lag = 10, type = "Ljung-Box")
ljung_box_var12_per_w
#VAR 2 estimation: growth, wage share, gini coefficient
print("VAR 2 estimation: growth, wage share, gini coefficient")
data_var2 <- cbind(g_per, w_per, gini_per)
var2_per <- VAR(data_var2, p=1, type = "none")
residuals_var2_per <- residuals(var2_per)
print("Growth")
ljung_box_var2_per_g <- Box.test(residuals_var2_per[, 1], lag = 10, type = "Ljung-Box")
ljung_box_var2_per_g
print("Wage share")
ljung_box_var2_per_w <- Box.test(residuals_var2_per[, 2], lag = 10, type = "Ljung-Box")
ljung_box_var2_per_w
print("Gini")
ljung_box_var2_per_gini <- Box.test(residuals_var2_per[, 3], lag = 10, type = "Ljung-Box")
ljung_box_var2_per_gini
#VAR 2.1 estimation: same as VAR 2 with gini coefficient as exogenous
