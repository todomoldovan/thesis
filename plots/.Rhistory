library(rvest)
library(dplyr)
# URL of the page to scrape
url <- "https://www.nigeriawatch.org/index.php?urlaction=evtList&cherche=1"
# Read the HTML content of the page
page <- read_html(url)
View(page)
# Extract the specific table by identifying its structure
# Use the class or id of the table if available
table <- page %>%
html_node("table.uk-table.uk-table-striped.uk-table-hover.uk-table-middle.uk-table-divider") %>%
html_table(fill = TRUE)
View(table)
